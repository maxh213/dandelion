#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
import { chmodSync, existsSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
import { VALUES, absent, bothNames, emit, perCall, perCallSync, repeat } from './timing.mjs';

const tree = process.env.MARESTAIL_PERF_TREE_PATH ?? process.cwd();
const main = join(tree, 'src', 'main.ts');
const appEntry = join(tree, 'src', 'app', 'index.ts');
const domainEntry = join(tree, 'src', 'domain', 'index.ts');
const NOW = '2026-09-14T12:39:00.000Z';
const MIDNIGHT = '2026-09-15T00:00:00.000Z';
const ZONE = 'Europe/London';
const ITERATIONS = 2000;

const TARGETS = {
  cliTripped: 'cli route eight providers claude-work session 100% tripped',
  runRouteTripped: 'runRoute eight providers claude-work session 100% tripped stub (in-process, per call)',
  routeLive100: 'routeLine 014 live case claude-work session 100% (in-process, per call)',
  routeLive89: 'routeLine 014 live case claude-work session 89% (in-process, per call)',
  routeAllTripped: 'routeLine every routable account tripped (in-process, per call)',
  highLive100: 'highRouteLine 014 live case claude-work session 100% (in-process, per call)'
};

const domain = existsSync(domainEntry) ? await import(pathToFileURL(domainEntry).href) : {};
const app = existsSync(appEntry) ? await import(pathToFileURL(appEntry).href) : {};

if (typeof domain.routeLine !== 'function' || typeof domain.highRouteLine !== 'function' || typeof app.runRoute !== 'function') {
  absent(...Object.values(TARGETS));
  process.exit(0);
}

const PERSONAL_OUT = [
  'Current session: 2% used · resets Sep 14, 5:40pm (Europe/London)',
  'Current week (all models): 13% used · resets Sep 19, 11pm (Europe/London)',
  'Current week (Fable): 2% used · resets Sep 19, 11pm (Europe/London)'
].join('\n') + '\n';
const WORK_OUT = [
  'Current session: 100% used · resets Sep 14, 4:50pm (Europe/London)',
  'Current week (all models): 72% used · resets Sep 14, 7pm (Europe/London)',
  'Current week (Fable): 52% used · resets Sep 14, 7pm (Europe/London)'
].join('\n') + '\n';
const AGY_OUT = 'Gemini Models\tWeekly Limit Remaining\t83%\t2026-09-19T18:39:00Z\n';
const KILO_OUT = 'Name: Max\nEmail: a@b.c\nTeam: Personal\nBalance: $14.15\n';

const fixture = mkdtempSync(join(tmpdir(), 'bench-trip-'));
const bin = join(fixture, 'bin');
const workDir = join(fixture, '.claude-work');
mkdirSync(bin);
mkdirSync(workDir);
writeFileSync(join(bin, 'claude'), `#!/bin/sh\nif [ -n "$CLAUDE_CONFIG_DIR" ]; then\ncat <<'OUT'\n${WORK_OUT}OUT\nelse\ncat <<'OUT'\n${PERSONAL_OUT}OUT\nfi\n`);
writeFileSync(join(bin, 'agy'), `#!/bin/sh\ncat <<'OUT'\n${AGY_OUT}OUT\n`);
writeFileSync(join(bin, 'kilo'), `#!/bin/sh\ncat <<'OUT'\n${KILO_OUT}OUT\n`);
for (const name of ['claude', 'agy', 'kilo']) chmodSync(join(bin, name), 0o755);

function timeCli() {
  const env = bothNames({ ...process.env, ALLOWANCE_STATE_FILE: join(tmpdir(), 'bench-no-dandelion-state', 'eligibility.json'), PATH: `${bin}:/usr/bin:/bin`, HOME: fixture, ALLOWANCE_GROK_HOME: fixture, ALLOWANCE_CURSOR_AUTH_FILE: join(fixture, 'missing-auth.json'), ALLOWANCE_CLAUDE_WORK_CONFIG_DIR: workDir });
  delete env.NO_COLOR;
  delete env.CLAUDE_CONFIG_DIR;
  delete env.ALLOWANCE_CURSOR_API_BASE;
  delete env.DANDELION_CURSOR_API_BASE;
  const start = process.hrtime.bigint();
  const result = spawnSync(process.execPath, [main, 'route'], { cwd: tree, env, stdio: ['ignore', 'pipe', 'pipe'], encoding: 'utf8' });
  const elapsed = Number(process.hrtime.bigint() - start) / 1e6;
  if (result.status !== 0 || result.stdout.split('\n').length !== 2) throw new Error(`route printed no single line (exit ${result.status}):\n${result.stdout}${result.stderr}`);
  return elapsed;
}

const runner = { run: async (command, _args, _timeout, env) => ({ stdout: command === 'claude' ? (env?.CLAUDE_CONFIG_DIR ? WORK_OUT : PERSONAL_OUT) : command === 'agy' ? AGY_OUT : command === 'kilo' ? KILO_OUT : '', stderr: '' }) };
const stubIo = {
  ...runner,
  runner,
  launcher: { launch: async () => undefined },
  spawner: { spawn: () => undefined },
  fetcher: { get: async () => ({ failure: 'network' }), post: async () => ({ failure: 'network' }) },
  reader: { homeDir: () => fixture, read: async () => undefined, isDirectory: async (path) => path === workDir }
};
const appEnv = bothNames({ ALLOWANCE_STATE_FILE: join(tmpdir(), 'bench-no-dandelion-state', 'eligibility.json'), ALLOWANCE_CLAUDE_WORK_CONFIG_DIR: workDir, ALLOWANCE_GROK_HOME: fixture, ALLOWANCE_CURSOR_AUTH_FILE: join(fixture, 'missing-auth.json') });
const request = { mode: 'headroom', now: NOW, zone: ZONE };

const HOUR = 60 * 60 * 1000;
const DAY = 24 * HOUR;
const at = (ms) => new Date(Date.parse(NOW) + ms).toISOString();
const win = (label, kind, usedPct, resetsAt) => ({ label, kind, usedPct, resetsAt });
const ok = (id, windows) => ({ id, displayName: id, planLabel: id, fetchedAt: NOW, status: 'ok', windows });
function liveFleet(workSession) {
  return [
    ok('claude', [win('session', 'rolling', 2, at(5 * HOUR)), win('weekly', 'weekly', 13, at(5 * DAY + 10 * HOUR)), win('weekly Fable', 'weekly', 2, at(5 * DAY + 10 * HOUR))]),
    ok('claude-work', [win('session', 'rolling', workSession, at(3 * HOUR + 11 * 60000)), win('weekly', 'weekly', 72, at(5 * HOUR + 21 * 60000)), win('weekly Fable', 'weekly', 52, at(5 * HOUR + 20 * 60000))]),
    ok('agy', [win('Gemini Models · Weekly Limit', 'weekly', 17, at(5 * DAY + 6 * HOUR)), win('Claude and GPT models · Five Hour Limit', 'rolling', 0, at(5 * HOUR))]),
    ok('kimi', [win('weekly', 'weekly', 95, at(3 * DAY + HOUR)), win('5h', 'rolling', 0, at(5 * HOUR))]),
    ok('grok', [win('credits', 'weekly', 9, at(5 * DAY + 10 * HOUR))]),
    { ...ok('codex', []), status: 'unavailable', reason: 'not found' },
    ok('cursor', [win('total', 'weekly', 36, at(15 * DAY + 5 * HOUR)), win('auto', 'weekly', 36, at(15 * DAY + 5 * HOUR)), win('api', 'weekly', 33, at(15 * DAY + 5 * HOUR))]),
    { ...ok('kilo', []), planLabel: 'api balance', balance: { amount: 14.15, currency: '$', reference: 20 } }
  ];
}
const live100 = liveFleet(100);
const live89 = liveFleet(89);
const allTripped = live100.map((usage) => (usage.windows.some((window) => window.kind === 'rolling')
  ? { ...usage, windows: usage.windows.map((window) => (window.kind === 'rolling' ? { ...window, usedPct: 95 } : window)) }
  : { ...usage, status: 'unavailable', windows: [], reason: 'not found' }));

function expectOneOf(actual, wanted, what) {
  if (!wanted.includes(actual)) throw new Error(`${what}: got ${JSON.stringify(actual)}, wanted one of ${JSON.stringify(wanted)}`);
}

try {
  const WORK_EVAPORATES = 'claude-opus-5 max claude-work';
  expectOneOf(domain.routeLine(live100, NOW, MIDNIGHT, []), ['grok-4.6 grok', WORK_EVAPORATES], 'live 100');
  expectOneOf(domain.routeLine(live89, NOW, MIDNIGHT, []), [WORK_EVAPORATES], 'live 89');
  expectOneOf(domain.routeLine(allTripped, NOW, MIDNIGHT, []), ['none', WORK_EVAPORATES], 'all tripped');
  expectOneOf(domain.highRouteLine(live100, []), ['claude-fable-5-1 max claude'], 'high live 100');
  const routed = await app.runRoute(stubIo, appEnv, request);
  if (routed.routed !== true) throw new Error(`runRoute did not route: ${JSON.stringify(routed)}`);

  timeCli();
  emit(TARGETS.cliTripped, await repeat(VALUES, timeCli), 'ms');
  emit(TARGETS.runRouteTripped, await perCall(ITERATIONS, () => app.runRoute(stubIo, appEnv, request)), 'us');
  emit(TARGETS.routeLive100, perCallSync(ITERATIONS, () => domain.routeLine(live100, NOW, MIDNIGHT, [])), 'us');
  emit(TARGETS.routeLive89, perCallSync(ITERATIONS, () => domain.routeLine(live89, NOW, MIDNIGHT, [])), 'us');
  emit(TARGETS.routeAllTripped, perCallSync(ITERATIONS, () => domain.routeLine(allTripped, NOW, MIDNIGHT, [])), 'us');
  emit(TARGETS.highLive100, perCallSync(ITERATIONS, () => domain.highRouteLine(live100, [])), 'us');
} finally {
  rmSync(fixture, { recursive: true, force: true });
}
