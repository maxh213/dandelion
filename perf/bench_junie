const TARGETS = {
  cli: 'cli one-shot nine providers junie 1.6MB session log',
  cliFallback: 'cli one-shot nine providers junie newest session without snapshot',
  cliEmpty: 'cli one-shot nine providers empty junie home',
  cliRoute: 'cli route nine providers junie 1.6MB session log',
  cliHigh: 'cli route --high nine providers junie 1.6MB session log',
  probeReal: 'probeJunie 1.6MB log, snapshot 20 lines from end, real reader (in-process, per call)',
  probeFallbackReal: 'probeJunie newest 0.8MB session without snapshot, older 1.6MB, real reader (in-process, per call)',
