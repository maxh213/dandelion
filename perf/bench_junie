  probeStub: 'probeJunie 1.6MB log stub reader (in-process, per call)',
  probeNoReference: 'probeJunie 1.6MB log no reference stub reader (in-process, per call)',
  probeWalkReal: 'probeJunie 40 sessions 135KB each none with snapshot, real reader (in-process, per call)',
