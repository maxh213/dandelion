#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
import { chmodSync, existsSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
import { BAD_ROUTES, ROUTE_LINES, fileReader, routing, writeRoutes } from './routes.mjs';
import { VALUES, absent, bothNames, emit, perCall, perCallSync, repeat } from './timing.mjs';

const tree = process.env.MARESTAIL_PERF_TREE_PATH ?? process.cwd();
const main = join(tree, 'src', 'main.ts');
const appEntry = join(tree, 'src', 'app', 'index.ts');
const terminalEntry = join(tree, 'src', 'render', 'terminal.ts');
const domainEntry = join(tree, 'src', 'domain', 'index.ts');
const shipped = join(tree, 'routes.json');
const NOW = '2026-09-14T11:00:00.000Z';
const ZONE = 'Europe/London';
const ITERATIONS = 2000;

const TARGETS = {
  cliShipped: 'cli route eight providers shipped routes.json',
  cliBad: 'cli route eight providers routes file unknown key',
  cliOnceBad: 'cli one-shot eight providers routes file unknown key',
  openFixture: 'openRoutes fixture file real reader (in-process, per call)',
  openShipped: 'openRoutes shipped routes.json real reader (in-process, per call)',
  openBad: 'openRoutes unknown key real reader (in-process, per call)',
  openMissing: 'openRoutes missing file real reader (in-process, per call)',
  runRouteBad: 'runRoute eight providers routes file unknown key (in-process, per call)',
  warning: 'routesWarning shipped routes.json (in-process, per call)',
  frameFault: 'renderLiveFrame eight settled routes file unknown key (in-process, per call)'
};
const FILE_ONLY = [TARGETS.cliBad, TARGETS.cliOnceBad, TARGETS.openFixture, TARGETS.openShipped, TARGETS.openBad, TARGETS.openMissing, TARGETS.runRouteBad, TARGETS.warning, TARGETS.frameFault];

const domain = existsSync(domainEntry) ? await import(pathToFileURL(domainEntry).href) : {};
const app = existsSync(appEntry) ? await import(pathToFileURL(appEntry).href) : {};

if (typeof domain.highRouteLine !== 'function' || typeof app.runRoute !== 'function') {
  absent(...Object.values(TARGETS));
  process.exit(0);
}

const R = routing(domain);

const PERSONAL_OUT = [
  'Current session: 3% used · resets Sep 14, 7:40pm (Europe/London)',
  'Current week (all models): 86% used · resets Sep 14, 11pm (Europe/London)',
  'Current week (Fable): 100% used · resets Sep 14, 11pm (Europe/London)'
].join('\n') + '\n';
const WORK_OUT = [
  'Current session: 0% used · resets Sep 14, 11:10pm (Europe/London)',
  'Current week (all models): 12% used · resets Sep 16, 6pm (Europe/London)',
  'Current week (Fable): 23% used · resets Sep 16, 6pm (Europe/London)'
].join('\n') + '\n';
const AGY_OUT = 'Gemini Models\tWeekly Limit Remaining\t100%\t2026-09-20T17:13:45Z\n';
const KILO_OUT = 'Name: Max\nEmail: a@b.c\nTeam: Personal\nBalance: $14.15\n';

const fixture = mkdtempSync(join(tmpdir(), 'bench-routes-file-'));
const bin = join(fixture, 'bin');
const workDir = join(fixture, '.claude-work');
const elsewhere = join(fixture, 'elsewhere');
mkdirSync(bin);
mkdirSync(workDir);
mkdirSync(elsewhere);
writeFileSync(join(bin, 'claude'), `#!/bin/sh\nif [ -n "$CLAUDE_CONFIG_DIR" ]; then\ncat <<'OUT'\n${WORK_OUT}OUT\nelse\ncat <<'OUT'\n${PERSONAL_OUT}OUT\nfi\n`);
writeFileSync(join(bin, 'agy'), `#!/bin/sh\ncat <<'OUT'\n${AGY_OUT}OUT\n`);
writeFileSync(join(bin, 'kilo'), `#!/bin/sh\ncat <<'OUT'\n${KILO_OUT}OUT\n`);
for (const name of ['claude', 'agy', 'kilo']) chmodSync(join(bin, name), 0o755);
const goodFile = writeRoutes(fixture);
const badFile = writeRoutes(fixture, BAD_ROUTES, 'bad-routes.json');
const missingFile = join(fixture, 'missing-routes.json');

function cliEnv(routesFile) {
  const env = bothNames({ ...process.env, ...(routesFile === undefined ? {} : { ALLOWANCE_ROUTES_FILE: routesFile }), ALLOWANCE_STATE_FILE: join(tmpdir(), 'bench-no-dandelion-state', 'eligibility.json'), PATH: `${bin}:/usr/bin:/bin`, HOME: fixture, ALLOWANCE_GROK_HOME: fixture, ALLOWANCE_JUNIE_HOME: fixture, ALLOWANCE_CURSOR_AUTH_FILE: join(fixture, 'missing-auth.json'), ALLOWANCE_HERMES_AUTH_FILE: join(fixture, 'missing-auth.json'), ALLOWANCE_CLAUDE_WORK_CONFIG_DIR: workDir });
  for (const name of ['NO_COLOR', 'CLAUDE_CONFIG_DIR', 'ALLOWANCE_CURSOR_API_BASE', 'DANDELION_CURSOR_API_BASE']) delete env[name];
  return env;
}

function timeCli(args, routesFile, check) {
  const env = cliEnv(routesFile);
  const start = process.hrtime.bigint();
  const result = spawnSync(process.execPath, [main, ...args], { cwd: elsewhere, env, stdio: ['ignore', 'pipe', 'pipe'], encoding: 'utf8' });
  const elapsed = Number(process.hrtime.bigint() - start) / 1e6;
  check(result);
  return elapsed;
}

function routedByShippedFile(result) {
  if (result.status !== 0 || result.stderr !== '') throw new Error(`route with the shipped file exited ${result.status}:\n${result.stdout}${result.stderr}`);
  if (!/^\S+( \S+)? \S+\n$/.test(result.stdout)) throw new Error(`route with the shipped file printed ${JSON.stringify(result.stdout)}`);
}

function faultedRoute(result) {
  if (result.status !== 2 || result.stdout !== '' || !result.stderr.includes('claude-wrok')) throw new Error(`route with a bad file exited ${result.status}:\n${result.stdout}${result.stderr}`);
}

function faultedDashboard(result) {
  if (result.status !== 0 || !result.stdout.includes('kilo') || !result.stderr.includes('claude-wrok')) throw new Error(`one-shot with a bad file exited ${result.status}:\n${result.stdout}${result.stderr}`);
}

const runner = { run: async (command, _args, _timeout, env) => ({ stdout: command === 'claude' ? (env?.CLAUDE_CONFIG_DIR ? WORK_OUT : PERSONAL_OUT) : command === 'agy' ? AGY_OUT : command === 'kilo' ? KILO_OUT : '', stderr: '' }) };
const stubIo = {
  ...runner,
  runner,
  launcher: { launch: async () => undefined },
  spawner: { spawn: () => undefined },
  fetcher: { get: async () => ({ failure: 'network' }), post: async () => ({ failure: 'network' }) },
  reader: { homeDir: () => fixture, read: async () => undefined, isDirectory: async (path) => path === workDir }
};
const badEnv = bothNames({ ALLOWANCE_ROUTES_FILE: badFile, ALLOWANCE_CLAUDE_WORK_CONFIG_DIR: workDir, ALLOWANCE_GROK_HOME: fixture, ALLOWANCE_JUNIE_HOME: fixture, ALLOWANCE_CURSOR_AUTH_FILE: join(fixture, 'missing-auth.json') });

const win = (label, kind, usedPct, resetsAt) => ({ label, kind, usedPct, resetsAt });
const fleet = [
  { id: 'claude', displayName: 'claude', planLabel: 'claude · personal', fetchedAt: NOW, status: 'ok', windows: [win('session', 'rolling', 3, '2026-09-14T18:40:00.000Z'), win('weekly', 'weekly', 86, '2026-09-19T22:00:00.000Z'), win('weekly Fable', 'weekly', 100, '2026-09-19T22:00:00.000Z')] },
  { id: 'claude-work', displayName: 'claude-work', planLabel: 'claude · work', fetchedAt: NOW, status: 'ok', windows: [win('session', 'rolling', 0, '2026-09-14T22:10:00.000Z'), win('weekly', 'weekly', 12, '2026-09-16T17:00:00.000Z'), win('weekly Fable', 'weekly', 23, '2026-09-16T17:00:00.000Z')] },
  { id: 'agy', displayName: 'agy', planLabel: 'agy', fetchedAt: NOW, status: 'ok', windows: [win('Gemini Models · Weekly Limit', 'weekly', 0, '2026-09-20T17:13:45Z')] },
  { id: 'kimi', displayName: 'kimi', planLabel: 'kimi', fetchedAt: NOW, status: 'ok', windows: [win('weekly', 'weekly', 20, '2026-09-18T00:00:00Z'), win('5h', 'rolling', 10, '2026-09-14T14:00:00Z')] },
  { id: 'grok', displayName: 'grok', planLabel: 'grok', fetchedAt: NOW, status: 'ok', windows: [win('credits', 'weekly', 55, '2026-10-01T00:00:00Z')] },
  { id: 'codex', displayName: 'codex', planLabel: 'codex', fetchedAt: NOW, status: 'unavailable', windows: [], reason: 'codex CLI not found' },
  { id: 'cursor', displayName: 'cursor', planLabel: 'Ultra · $200/mo', fetchedAt: NOW, status: 'ok', windows: [win('total', 'weekly', 31, '2026-09-30T16:45:06.000Z')] },
  { id: 'kilo', displayName: 'kilo', planLabel: 'api balance', windows: [], fetchedAt: NOW, status: 'ok', balance: { amount: 14.15, currency: '$', reference: 20 } }
];

try {
  timeCli(['route'], undefined, routedByShippedFile);
  emit(TARGETS.cliShipped, await repeat(VALUES, () => timeCli(['route'], undefined, routedByShippedFile)), 'ms');

  if (!R.fromFile) {
    absent(...FILE_ONLY);
  } else {
    timeCli(['route'], badFile, faultedRoute);
    emit(TARGETS.cliBad, await repeat(VALUES, () => timeCli(['route'], badFile, faultedRoute)), 'ms');
    timeCli([], badFile, faultedDashboard);
    emit(TARGETS.cliOnceBad, await repeat(VALUES, () => timeCli([], badFile, faultedDashboard)), 'ms');

    const open = (path) => domain.openRoutes({}, path, fileReader);
    if (JSON.stringify(open(goodFile).lines) !== JSON.stringify(ROUTE_LINES)) throw new Error('openRoutes did not load the fixture lines');
    if (open(shipped).lines === undefined) throw new Error(`openRoutes faulted on the shipped file: ${JSON.stringify(open(shipped).fault)}`);
    if (!String(open(badFile).fault?.problem).includes('claude-wrok')) throw new Error('openRoutes did not name the unknown key');
    if (open(missingFile).fault === undefined) throw new Error('openRoutes read a missing file');
    emit(TARGETS.openFixture, perCallSync(ITERATIONS, () => open(goodFile)), 'us');
    emit(TARGETS.openShipped, perCallSync(ITERATIONS, () => open(shipped)), 'us');
    emit(TARGETS.openBad, perCallSync(ITERATIONS, () => open(badFile)), 'us');
    emit(TARGETS.openMissing, perCallSync(ITERATIONS, () => open(missingFile)), 'us');

    const request = { mode: 'headroom', now: NOW, zone: ZONE };
    const bad = await app.runRoute(stubIo, badEnv, request);
    if (bad.code !== 2 || !bad.err.includes('claude-wrok')) throw new Error(`runRoute with a bad file gave ${JSON.stringify(bad)}`);
    emit(TARGETS.runRouteBad, await perCall(ITERATIONS, () => app.runRoute(stubIo, badEnv, request)), 'us');

    if (app.routesWarning({}) !== '') throw new Error(`routesWarning faulted on the shipped file: ${app.routesWarning({})}`);
    emit(TARGETS.warning, perCallSync(ITERATIONS, () => app.routesWarning({})), 'us');

    const terminal = await import(pathToFileURL(terminalEntry).href);
    const view = { slots: fleet.map((usage) => ({ id: usage.id, usage })), spinner: 3, refreshing: true, footer: true, ineligible: [], zone: ZONE, routes: open(badFile), settled: fleet };
    const frame = terminal.renderLiveFrame(view, false, NOW);
    if (!frame.includes('routes file error') || frame !== terminal.renderLiveFrame(view, false, NOW)) throw new Error(`fault frame drew no routes file error:\n${frame}`);
    emit(TARGETS.frameFault, perCallSync(ITERATIONS, () => terminal.renderLiveFrame(view, false, NOW)), 'us');
  }
} finally {
  rmSync(fixture, { recursive: true, force: true });
}
