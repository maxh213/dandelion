{
  "route": {
    "claude":      { "standard": "claude-opus-5-5 high",       "max": "claude-opus-5-5 max" },
    "claude-work": { "standard": "claude-opus-5-5 high",       "max": "claude-opus-5-5 max" },
    "claude-animus": { "standard": "claude-opus-5-5 high",     "max": "claude-opus-5-5 max", "limit": 75 },
    "claude-deepseek": { "standard": "deepseek/deepseek-v4.1-flash max", "max": "deepseek/deepseek-v4.1-flash max" },
    "claude-ollama": { "standard": "glm-5.3-flash max", "max": "glm-5.3-flash max", "limit": 60 },
    "agy":         { "standard": "gemini-3.8-flash-high high", "max": "gemini-4-argon-high high" },
    "kimi":        { "standard": "kimi-code/k3.1-pro-highspeed max", "max": "kimi-code/k3.1-pro-highspeed max" },
    "grok":        { "standard": "grok-4.7 xhigh",             "max": "grok-4.7 xhigh" },
    "codex":       { "standard": "gpt-6.1-sol high",           "max": "gpt-6.1-sol xhigh" },
    "codex-animus": { "standard": "gpt-6.1-sol high",          "max": "gpt-6.1-sol xhigh", "limit": 25 },
    "cursor":      { "standard": "auto",                       "max": "auto" },
    "junie":       { "standard": "gemini-3.8-flash high",      "max": "gemini-3.8-flash high" },
    "hermes":      { "standard": "x-ai/grok-4.7 xhigh",        "max": "x-ai/grok-4.7 xhigh" },
    "kilo":        { "standard": "deepseek/deepseek-v4.1-flash-1017 max", "max": "deepseek/deepseek-v4.1-flash-1017 max" }
  },
  "high": {
    "fable":  "claude-fable-5-1 max",
    "codex":  "gpt-6-astra xhigh",
    "cursor": "kimi-k3-max",
    "opus":   "claude-opus-5-5 max",
    "grok":   "grok-4.7 xhigh",
    "agy":    "gemini-4-argon-high high"
  },
  "swarm": {
    "trip": 80,
    "minLeft": 5,
    "exclude": ["claude-work", "claude-animus", "codex-animus"],
    "cap": { "claude": 4, "codex": 3, "cursor": 3, "agy": 3, "kilo": 1, "default": 2 },
    "burnPerSeatHour": { "default": 10 }
  },
  "lab": {
    "claude-": "anthropic", "gpt-": "openai", "gemini-": "google", "grok-": "xai", "x-ai/": "xai",
    "kimi": "moonshot", "deepseek": "deepseek", "glm-": "zhipu", "auto": "cursor"
  },
  "headless": {
    "claude": { "before": [],       "after": ["-p", "--output-format", "json", "--dangerously-skip-permissions"], "stdin": true },
    "codex":  { "before": ["exec"], "after": ["--dangerously-bypass-approvals-and-sandbox", "-"], "stdin": true },
    "agy":    { "before": [],       "after": ["--dangerously-skip-permissions", "-p", "{prompt}"], "stdin": false },
    "kimi":   { "before": [],       "after": ["-p", "{prompt}"], "stdin": false },
    "grok":   { "before": [],       "after": ["--always-approve", "--output-format", "plain", "--prompt-file", "{promptFile}"], "stdin": false }
  }
}
